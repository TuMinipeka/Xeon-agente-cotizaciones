APP_ENV=development
DATA_MODE=synthetic
DEFAULT_TIMEZONE=America/Bogota

# mock nunca llama a un proveedor externo. Cambiar a groq de forma consciente.
LLM_PROVIDER=mock
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=120
AGENT_MAX_STEPS=6

# Solo para desarrollo fuera de Docker. No guardar la clave real en este archivo.
GROQ_API_KEY=
GROQ_API_KEY_FILE=

# Canal WhatsApp sin costo mediante Evolution API (opcional en modo local)
WHATSAPP_SEND_ENABLED=false
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_INSTANCE=xeon-ferreteria
EVOLUTION_API_KEY=
EVOLUTION_API_KEY_FILE=

LOG_LEVEL=INFO
