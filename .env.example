APP_ENV=development
DATA_MODE=synthetic
DEFAULT_TIMEZONE=America/Bogota

# mock nunca llama a un proveedor externo. Cambiar a grok de forma consciente.
LLM_PROVIDER=mock
LLM_MODEL=grok-4.6
LLM_BASE_URL=https://api.reto.pltk.mx/v1
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=120
AGENT_MAX_STEPS=6

# Solo para desarrollo fuera de Docker. No guardar la clave real en este archivo.
RETO_KEY=
RETO_KEY_FILE=

LOG_LEVEL=INFO

