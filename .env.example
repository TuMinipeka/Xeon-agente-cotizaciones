APP_ENV=development
DATA_MODE=synthetic
DEFAULT_TIMEZONE=America/Bogota

# Grok usa la pasarela del reto. Para pruebas sin red, usar LLM_PROVIDER=mock.
LLM_PROVIDER=grok
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=120
AGENT_MAX_STEPS=6

# Solo para desarrollo fuera de Docker con Groq directo. No guardar la clave real en este archivo.
GROQ_API_KEY=
GROQ_API_KEY_FILE=

# Grok (xAI): la clave real queda solo en el archivo local ignorado por Git.
GROK_API_KEY=
GROK_API_KEY_FILE=secrets/grok_api_key.txt
GROK_MODEL=grok-4.6
GROK_BASE_URL=https://api.reto.pltk.mx/v1

# Kapso es el canal WhatsApp.
WHATSAPP_SEND_ENABLED=false
KAPSO_API_BASE_URL=https://api.kapso.ai
KAPSO_API_KEY=
KAPSO_API_KEY_FILE=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=
KAPSO_WEBHOOK_SECRET_FILE=secrets/kapso_webhook_secret.txt
META_GRAPH_VERSION=v24.0

LOG_LEVEL=INFO
