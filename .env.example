APP_ENV=development
DATA_MODE=synthetic
DEFAULT_TIMEZONE=America/Bogota

# Grok usa la pasarela del reto. Para pruebas sin red, usar LLM_PROVIDER=mock.
LLM_PROVIDER=grok
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=120
AGENT_MAX_STEPS=6

# Puente hacia Hermes Agent local (:8642/v1, usa temporalmente gpt-5.6-luna o el modelo activo en Hermes)
HERMES_BASE_URL=http://127.0.0.1:8642/v1
HERMES_MODEL=gpt-5.6-luna
HERMES_API_KEY=xeon-hermes-local-bridge-2026
HERMES_API_KEY_FILE=

# Solo para desarrollo fuera de Docker con Groq directo. No guardar la clave real en este archivo.
GROQ_API_KEY=
GROQ_API_KEY_FILE=

# Grok (xAI): la clave real queda solo en el archivo local ignorado por Git.
GROK_API_KEY=
GROK_API_KEY_FILE=secrets/grok_api_key.txt
GROK_MODEL=grok-4.20-0309-non-reasoning
GROK_BASE_URL=https://api.reto.pltk.mx/v1

# Canal WhatsApp sin costo ($0) mediante Evolution API (modo Baileys QR)
WHATSAPP_SEND_ENABLED=false
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_INSTANCE=xeon-ferreteria
EVOLUTION_API_KEY=xeon-evolution-local-key
EVOLUTION_API_KEY_FILE=

LOG_LEVEL=INFO
